<?xml version="1.0" encoding="UTF-8"?>
<model name="uo:contentModel" xmlns="http://www.alfresco.org/model/dictionary/1.0">

    <!-- Optional meta-data about the model -->
    <description>UO Content Model</description>
    <version>1.0</version>

    <imports>
        <!-- Import Alfresco Dictionary Definitions -->
        <import uri="http://www.alfresco.org/model/dictionary/1.0" prefix="d"/>
        <!-- Import Alfresco Content Domain Model Definitions -->
        <import uri="http://www.alfresco.org/model/content/1.0" prefix="cm"/>
        <!-- Import Alfresco System Model Definitions -->
        <import uri="http://www.alfresco.org/model/system/1.0" prefix="sys"/>
    </imports>

    <!-- Custom namespace for the ACME company -->
    <namespaces>
        <namespace uri="http://www.uniovi.es/model/content/1.0" prefix="uo"/>
    </namespaces>

    <!-- ===============================================================================================================
        Constraints, Types, and Aspects go here...
        -->

    <types>
        <type name="uo:record">
            <title>Expediente Universitario</title>
            <parent>cm:folder</parent>
        </type>

        <type name="uo:student">
            <title>Alumno</title>
        </type>

        <type name="uo:task">
            <title>Tarea</title>
            <parent>cm:folder</parent>
        </type>
    </types>

    <aspects>
        <aspect name="uo:studentAsp">
            <properties>
                <property name="uo:id">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>

                <property name="uo:name">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>

                <property name="uo:surname">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>
            </properties>
        </aspect>

        <aspect name="uo:recordAsp">
            <properties>
                <property name="uo:recordNumber">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                    <index enabled="true"/>
                </property>

                <property name="uo:openingDate">
                    <type>d:date</type>
                    <mandatory>true</mandatory>
                </property>

                <property name="uo:studentUUID">
                    <type>d:date</type>
                    <mandatory>true</mandatory>
                </property>

                <property name="uo:recordStatus">
                    <type>d:text</type>
                </property>

                <property name="uo:title">
                    <type>d:text</type>
                </property>

                <property name="uo:center">
                    <type>d:text</type>
                </property>

                <property name="uo:type">
                    <type>d:text</type>
                </property>

                <property name="uo:responsible">
                    <type>d:text</type>
                </property>
            </properties>
        </aspect>

        <aspect name="uo:taskAsp">
            <properties>
                <property name="uo:title">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>

                <property name="uo:description">
                    <type>d:text</type>
                </property>

                <property name="uo:studentUUID">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>

                <property name="uo:dueDate">
                    <type>d:date</type>
                </property>

                <property name="uo:score">
                    <type>d:float</type>
                </property>

                <property name="uo:taskStatus">
                    <type>d:text</type>
                </property>
            </properties>
        </aspect>
    </aspects>

</model>