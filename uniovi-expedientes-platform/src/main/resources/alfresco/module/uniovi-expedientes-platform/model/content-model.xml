<?xml version="1.0" encoding="UTF-8"?>
<model name="uo:contentModel" xmlns="http://www.alfresco.org/model/dictionary/1.0">

    <!-- Optional meta-data about the model -->
    <description>UO Content Model</description>
    <version>1.0</version>

    <imports>
        <!-- Import Alfresco Dictionary Definitions -->
        <import uri="http://www.alfresco.org/model/dictionary/1.0" prefix="d"/>
        <!-- Import Alfresco Content Domain Model Definitions -->
        <import uri="http://www.alfresco.org/model/content/1.0" prefix="cm"/>
        <!-- Import Alfresco System Model Definitions -->
        <import uri="http://www.alfresco.org/model/system/1.0" prefix="sys"/>
    </imports>

    <!-- Custom namespace for the ACME company -->
    <namespaces>
        <namespace uri="http://www.uniovi.es/model/content/1.0" prefix="uo"/>
    </namespaces>

    <!-- ===============================================================================================================
        Constraints, Types, and Aspects go here...
        -->

    <types>
        <type name="uo:record">
            <title>Expediente Universitario</title>
            <parent>cm:folder</parent>
        </type>

        <type name="uo:student">
            <title>Alumno</title>
            <parent>cm:folder</parent>
        </type>

        <type name="uo:studentTask">
            <title>Tarea</title>
            <parent>cm:folder</parent>
        </type>

        <type name="uo:task">
            <title>Tarea</title>
            <parent>cm:folder</parent>
        </type>

        <type name="uo:subject">
            <title>Asignatura</title>
            <parent>cm:folder</parent>
        </type>

        <type name="uo:file">
            <title>Archivo</title>
            <parent>cm:content</parent>
        </type>
    </types>

    <aspects>
        <aspect name="uo:studentAsp">
            <properties>
                <property name="uo:studentId">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>
                <property name="uo:studentUo">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>
                <property name="uo:studentName">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>

                <property name="uo:studentSurname">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>

                <property name="uo:studentEmail">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>
            </properties>
        </aspect>

        <aspect name="uo:recordAsp">
            <properties>
                <property name="uo:recordNumber">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                    <index enabled="true"/>
                </property>

                <property name="uo:openingDate">
                    <type>d:date</type>
                    <mandatory>true</mandatory>
                </property>

                <property name="uo:recordTitle">
                    <type>d:text</type>
                </property>

                <property name="uo:center">
                    <type>d:text</type>
                </property>

                <property name="uo:type">
                    <type>d:text</type>
                </property>

                <property name="uo:responsible">
                    <type>d:text</type>
                </property>
            </properties>
        </aspect>

        <aspect name="uo:taskAsp">
            <properties>
                <property name="uo:taskTitle">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>

                <property name="uo:subjectUUID">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>

                <property name="uo:description">
                    <type>d:text</type>
                </property>

                <property name="uo:dueDate">
                    <type>d:date</type>
                </property>
            </properties>
        </aspect>

        <aspect name="uo:studentTaskAsp">
            <properties>
                <property name="uo:parentTaskUUID">
                    <type>d:text</type>
                </property>
                <property name="uo:score">
                    <type>d:float</type>
                </property>
            </properties>
        </aspect>

        <aspect name="uo:subjectAsp">
            <properties>
                <property name="uo:schoolYear">
                    <type>d:text</type>
                </property>
                <property name="uo:subjectName">
                    <type>d:text</type>
                </property>
                <property name="uo:enrolled">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                    <multiple>true</multiple>
                </property>

                <property name="uo:professors">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                    <multiple>true</multiple>
                </property>
            </properties>
        </aspect>

        <aspect name="uo:studentUUIDAsp">
            <properties>
                <property name="uo:studentUUID">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                </property>
            </properties>
        </aspect>

        <aspect name="uo:filesAsp">
            <properties>
                <property name="uo:filesUUIDs">
                    <type>d:text</type>
                    <mandatory>true</mandatory>
                    <multiple>true</multiple>
                </property>
            </properties>
        </aspect>


        <aspect name="uo:statusAsp">
            <properties>
                <property name="uo:status">
                    <type>d:text</type>
                </property>
            </properties>
        </aspect>
    </aspects>

</model>